{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "impactolocal",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-28",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"vars": {
